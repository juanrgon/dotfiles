#!/usr/bin/env bash
# Print the command that copies stdin to the clipboard on this machine.
# Prints nothing if no clipboard tool is available.
#
# Usage: echo hello | $(clipboard_command)

if command -v pbcopy &> /dev/null; then
    echo "pbcopy"
elif [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy &> /dev/null; then
    echo "wl-copy"
elif [ -n "${DISPLAY:-}" ] && command -v xclip &> /dev/null; then
    echo "xclip -selection clipboard"
fi
